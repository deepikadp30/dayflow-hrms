# Dayflow Backend Environment Configuration Template
SECRET_KEY=django-insecure-change-this-in-production-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=dayflow_db
DB_USER=dayflow_user
DB_PASSWORD=dayflow_secure_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Fallback to SQLite if MySQL is unavailable
USE_SQLITE_FALLBACK=True

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:3000
